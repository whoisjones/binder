{
    "run_name": "all-stages",
    "output_dir": "/vol/tmp/goldejon/multilingual_ner/binder/models/binder_focal",
    "text_encoder": "FacebookAI/xlm-roberta-base",
    "type_encoder": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "train_file": ["finerweb_eng"],
    "do_train": true,
    "num_train_epochs": 1,
